FROM node:22-bookworm

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH=/root/.cargo/bin:${PATH}

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        bubblewrap \
        ca-certificates \
        curl \
        desktop-file-utils \
        file \
        fonts-freefont-ttf \
        fonts-ipafont-gothic \
        fonts-liberation \
        fonts-noto-color-emoji \
        fonts-tlwg-loma-otf \
        fonts-unifont \
        fonts-wqy-zenhei \
        git \
        gstreamer1.0-plugins-base \
        gstreamer1.0-plugins-good \
        libayatana-appindicator3-dev \
        libcap2 \
        libclang-dev \
        libfuse2 \
        libfontenc1 \
        libgtk-3-dev \
        libnspr4 \
        libnss3 \
        libpipewire-0.3-dev \
        librsvg2-dev \
        libspa-0.2-dev \
        libusb-1.0-0 \
        libwebkit2gtk-4.1-dev \
        libxaw7 \
        libxfont2 \
        libxkbfile1 \
        libxmu6 \
        libxpm4 \
        patchelf \
        pkg-config \
        python3 \
        rpm \
        ripgrep \
        shellcheck \
        squashfs-tools \
        xdg-dbus-proxy \
        xdg-utils \
        x11-xkb-utils \
        xfonts-encodings \
        xfonts-scalable \
        xfonts-utils \
        xserver-common \
        xvfb \
    && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --profile minimal --default-toolchain stable \
    && rustup component add clippy rustfmt \
    && corepack enable \
    && corepack prepare yarn@1.22.22 --activate

# Keep the screenshot-test browser in the release image so clean gates do not
# depend on a developer's Playwright cache.
WORKDIR /opt/wavelinux-playwright
COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile \
    && yarn playwright install --with-deps chromium \
    && rm -rf node_modules

WORKDIR /work
