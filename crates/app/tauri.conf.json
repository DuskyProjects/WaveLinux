{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WaveLinux6",
  "mainBinaryName": "wavelinux6",
  "version": "6.0.2",
  "identifier": "io.github.duskyprojects.WaveLinux6",
  "build": {
    "beforeDevCommand": "cd .. && node node_modules/.bin/vite --port 1420",
    "beforeBuildCommand": "cd .. && node node_modules/.bin/tsc && node node_modules/.bin/vite build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../../dist"
  },
  "app": {
    "enableGTKAppId": true,
    "windows": [
      {
        "title": "WaveLinux 6",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "Linux creator audio mixer",
    "longDescription": "WaveLinux 6 is a Rust and PipeWire creator audio mixer for Linux.",
    "linux": {
      "appimage": {
        "bundleMediaFramework": true,
        "files": {
          "/usr/lib": "appimage-extra/usr/lib",
          "/usr/share/metainfo": "appimage-extra/usr/share/metainfo",
          "/usr/wavelinux-runtime": "appimage-extra/usr/wavelinux-runtime"
        }
      },
      "deb": {
        "files": {
          "/usr/bin/wavelinux6-audio-core": "../../target/release/wavelinux6-audio-core",
          "/usr/bin/wavelinux6-peripheral-plugin": "../../target/release/wavelinux6-peripheral-plugin",
          "/usr/lib/wavelinux6/check-dependencies.sh": "../../scripts/check-dependencies.sh",
          "/usr/lib/wavelinux6/runtime-dependencies.sh": "../../scripts/runtime-dependencies.sh",
          "/usr/lib/wavelinux6/wavelinux-processes.sh": "../../scripts/wavelinux-processes.sh",
          "/usr/lib/wavelinux6/verify-install.sh": "../../scripts/verify-install.sh",
          "/usr/share/metainfo/io.github.duskyprojects.WaveLinux6.appdata.xml": "appimage-extra/usr/share/metainfo/io.github.duskyprojects.WaveLinux6.appdata.xml"
        },
        "depends": [
          "gawk",
          "procps",
          "pipewire",
          "pipewire-audio",
          "wireplumber",
          "pipewire-pulse",
          "pipewire-bin",
          "pulseaudio-utils",
          "alsa-utils",
          "libasound2-plugins",
          "rtkit",
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1",
          "libusb-1.0-0",
          "bubblewrap",
          "xdg-dbus-proxy",
          "xwayland",
          "libegl1",
          "libgl1",
          "libgbm1",
          "libdrm2",
          "libwayland-client0",
          "libwayland-cursor0",
          "libwayland-egl1",
          "libwayland-server0",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "fontconfig",
          "fonts-dejavu-core",
          "xdg-desktop-portal",
          "xdg-desktop-portal-gtk"
        ],
        "recommends": []
      },
      "rpm": {
        "files": {
          "/usr/bin/wavelinux6-audio-core": "../../target/release/wavelinux6-audio-core",
          "/usr/bin/wavelinux6-peripheral-plugin": "../../target/release/wavelinux6-peripheral-plugin",
          "/usr/lib/wavelinux6/check-dependencies.sh": "../../scripts/check-dependencies.sh",
          "/usr/lib/wavelinux6/runtime-dependencies.sh": "../../scripts/runtime-dependencies.sh",
          "/usr/lib/wavelinux6/wavelinux-processes.sh": "../../scripts/wavelinux-processes.sh",
          "/usr/lib/wavelinux6/verify-install.sh": "../../scripts/verify-install.sh",
          "/usr/share/metainfo/io.github.duskyprojects.WaveLinux6.appdata.xml": "appimage-extra/usr/share/metainfo/io.github.duskyprojects.WaveLinux6.appdata.xml"
        },
        "depends": [
          "gawk",
          "procps-ng",
          "pipewire",
          "pipewire-utils",
          "pipewire-alsa",
          "wireplumber",
          "pipewire-pulseaudio",
          "pulseaudio-utils",
          "alsa-utils",
          "alsa-plugins-pulseaudio",
          "rtkit",
          "webkit2gtk4.1",
          "libappindicator-gtk3",
          "libusb1",
          "bubblewrap",
          "xdg-dbus-proxy",
          "xorg-x11-server-Xwayland",
          "mesa-libEGL",
          "mesa-libGL",
          "mesa-libgbm",
          "libdrm",
          "libwayland-client",
          "libwayland-cursor",
          "libwayland-egl",
          "libwayland-server",
          "gstreamer1-plugins-base",
          "gstreamer1-plugins-good",
          "fontconfig",
          "google-noto-sans-fonts",
          "xdg-desktop-portal",
          "xdg-desktop-portal-gtk"
        ],
        "recommends": []
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaW5pIHB1YmxpYyBrZXk6IDc2QjhFQjM3NzFDRkY2MwpSV1JqL3h4M3M0NXJCMXJDbm5GQ3F2ajdPdVRzanBIREJQYzdHL2FTVG44cFFTVm5XWlZQeVBqawo=",
      "endpoints": [
        "https://github.com/DuskyProjects/WaveLinux/releases/latest/download/latest.json"
      ]
    }
  }
}
