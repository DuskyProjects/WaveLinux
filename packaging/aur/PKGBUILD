# Maintainer: WaveLinux contributors <https://github.com/DuskyProjects/WaveLinux>
pkgname=wavelinux
pkgver=6.0.1
pkgrel=1
pkgdesc="Rust and PipeWire creator audio mixer for Linux"
arch=('x86_64')
url="https://github.com/DuskyProjects/WaveLinux"
license=('GPL-3.0-only')
install=$pkgname.install
depends=(
  'gawk'
  'procps-ng'
  'pipewire'
  'pipewire-audio'
  'pipewire-alsa'
  'pipewire-pulse'
  'wireplumber'
  'libpulse'
  'alsa-utils'
  'alsa-plugins'
  'rtkit'
  'webkit2gtk-4.1'
  'gtk3'
  'libayatana-appindicator'
  'libusb'
  'bubblewrap'
  'xdg-dbus-proxy'
  'xorg-xwayland'
  'mesa'
  'libglvnd'
  'wayland'
  'libdrm'
  'fontconfig'
  'gstreamer'
  'gst-plugins-base-libs'
  'gst-plugins-good'
  'noto-fonts'
  'xdg-desktop-portal'
  'xdg-desktop-portal-gtk'
)
makedepends=(
  'git'
  'nodejs'
  'yarn'
  'rust'
  'pkgconf'
  'libpipewire'
  'librsvg'
  'patchelf'
)
source=("$pkgname-$pkgver.tar.gz::https://github.com/DuskyProjects/WaveLinux/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "WaveLinux-$pkgver"
  yarn install --frozen-lockfile
  node node_modules/.bin/tsc --noEmit
  node node_modules/.bin/vite build
  cargo build --release --locked -p wavelinux-app --bin wavelinux6
  cargo build --release --locked -p wavelinux-app --bin wavelinux6-peripheral-plugin
  cargo build --release --locked -p wavelinux-dsp --bin wavelinux6-audio-core
}

check() {
  cd "WaveLinux-$pkgver"
  cargo test --workspace --locked
}

package() {
  cd "WaveLinux-$pkgver"
  install -Dm755 target/release/wavelinux6 "$pkgdir/usr/bin/wavelinux6"
  install -Dm755 target/release/wavelinux6-audio-core "$pkgdir/usr/bin/wavelinux6-audio-core"
  install -Dm755 target/release/wavelinux6-peripheral-plugin "$pkgdir/usr/bin/wavelinux6-peripheral-plugin"
  install -Dm755 scripts/check-dependencies.sh "$pkgdir/usr/lib/wavelinux6/check-dependencies.sh"
  install -Dm755 scripts/runtime-dependencies.sh "$pkgdir/usr/lib/wavelinux6/runtime-dependencies.sh"
  install -Dm755 scripts/wavelinux-processes.sh "$pkgdir/usr/lib/wavelinux6/wavelinux-processes.sh"
  install -Dm755 scripts/verify-install.sh "$pkgdir/usr/lib/wavelinux6/verify-install.sh"
  install -Dm644 crates/app/icons/icon.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/wavelinux6.png"
  install -Dm644 crates/app/icons/icon.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/wavelinux6.svg"
  install -Dm644 crates/app/appimage-extra/usr/share/metainfo/io.github.duskyprojects.WaveLinux6.appdata.xml \
    "$pkgdir/usr/share/metainfo/io.github.duskyprojects.WaveLinux6.appdata.xml"
  install -Dm644 packaging/udev/70-wavelinux-streamer-devices.rules "$pkgdir/usr/lib/udev/rules.d/70-wavelinux-streamer-devices.rules"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"

  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/io.github.duskyprojects.WaveLinux6.desktop" <<'DESKTOP'
[Desktop Entry]
Type=Application
Name=WaveLinux 6
Comment=Linux creator audio mixer
Exec=wavelinux6
Icon=wavelinux6
Terminal=false
Categories=Audio;AudioVideo;Mixer;
StartupWMClass=io.github.duskyprojects.WaveLinux6
DESKTOP
}
